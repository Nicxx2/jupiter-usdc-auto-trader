# Copy this file to .env, fill every required value, and keep it private.
# Generate each secret independently with: openssl rand -hex 32
# Never rotate these values casually on an existing installation.

N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
GATEWAY_PASSPHRASE=

# Required source: https://github.com/Nicxx2/jupiter-usdc-price-alerts
# Jupiter USDC Price Alerts on this same Docker host.
# Change only the port when the source app is not using its default port 8000.
APP_API_PORT=8000

# For a different server, uncomment and enter the complete endpoint.
# A non-empty APP_API_URL overrides APP_API_PORT.
# Do not use loopback/localhost hosts, port 0, embedded credentials,
# query-string API keys, or a URL that does not end in /api/tokens.
# Prefer a private network; this integration does not add source API authentication.
# APP_API_URL=https://alerts.example.com/api/tokens

# Set true only when port 5680 is accessed exclusively through HTTPS.
# Leave false for direct http://SERVER-IP:5680 access or login will not persist.
# DASHBOARD_COOKIE_SECURE=true

# Must match Jupiter Alerts. For ntfy on this host, use
# http://host.docker.internal:PORT rather than localhost.
# NTFY_SERVER=https://ntfy.sh
# TZ=Europe/London
